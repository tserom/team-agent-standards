{
  "version": 1,
  "rules": [
    {
      "output": "karpathy-guidelines.mdc",
      "guideline": "karpathy.md",
      "description": "Behavioral guidelines to reduce common LLM coding mistakes. Use when writing, reviewing, or refactoring code.",
      "alwaysApply": true
    },
    {
      "output": "react-readability-conventions.mdc",
      "guideline": "react-readability.md",
      "description": "React/UI 与 *Api 可读性约定（少抽象、少 useEffect 业务链、入口注释）",
      "alwaysApply": false,
      "globs": ["src/**/*.tsx", "src/**/*Api.ts"]
    },
    {
      "output": "antd-input-number-select-on-focus.mdc",
      "guideline": "antd-input-number-select-on-focus.md",
      "description": "antd InputNumber 聚焦全选，避免每次先清 0.00；优先用项目封装",
      "alwaysApply": false,
      "globs": ["**/*.{tsx,jsx}"]
    },
    {
      "output": "response-modified-files-summary.mdc",
      "guideline": "response-modified-files.md",
      "description": "改代码后在回复末尾用表格列出修改的文件及简要说明",
      "alwaysApply": true
    },
    {
      "output": "git-commit-message-continuity.mdc",
      "guideline": "git-commit-mr.md",
      "description": "连续提交时在 feat 文案末尾追加序号；合代码只推功能分支并建 MR/PR 草稿或给出链接，不直接 merge/push 到其它分支",
      "alwaysApply": true
    },
    {
      "output": "api-layering-decision.mdc",
      "guideline": "api-layering.md",
      "description": "前端 API 层 L0–L3；响应字段契约（禁止未声明业务字段 ?? 链）；实现 *Api.ts / services 前必读",
      "alwaysApply": true
    },
    {
      "output": "api-query-predicate-params.mdc",
      "guideline": "api-query-predicate-params.md",
      "description": "API 查询谓词参数 qp-<field>-<operator>：field 用公开 API 字段名，后端白名单映射，禁止暴露数据库列名或拼 SQL",
      "alwaysApply": true
    },
    {
      "output": "api-list-sorter-params.mdc",
      "guideline": "api-list-sorter-params.md",
      "description": "API 列表排序 sorter=<asc|desc>-<field>：与 qp-* 并列，field 白名单映射，禁止硬编码 Order 或拼 SQL",
      "alwaysApply": true
    },
    {
      "output": "promote-to-team-standards.mdc",
      "guideline": "promote-to-team-standards.md",
      "description": "可复用规则/Skill 时提醒用户是否晋升到 team-agent-standards；说明 guidelines/docs/skills 分工",
      "alwaysApply": true
    },
    {
      "output": "receipt-batch-detail-tab.mdc",
      "guideline": "receipt-batch-detail-tab.md",
      "description": "详情页收货批次明细 Tab：STOCKBATCH_ENABLED、新列表接口、*ReceiptBatchRow 显式字段、回退登记表；勿照搬 other-in 字段链",
      "alwaysApply": false,
      "globs": ["src/**/*Api.ts", "src/**/services/**", "src/pages/**/detail*.tsx", "src/pages/**/create.tsx", "src/pages/**/*Section*.tsx", "src/pages/**/*Batch*.tsx"]
    },
    {
      "output": "table-summary-field-map.mdc",
      "guideline": "table-summary-field-map.md",
      "description": "表格/导出合计按字段 key 映射，禁止 colSpan/下标数格子；前后端一致",
      "alwaysApply": false,
      "globs": [
        "**/*List*.tsx",
        "**/*export*.{ts,tsx}",
        "**/*Export*.{ts,tsx}",
        "**/*xlsx*.{ts,tsx}",
        "**/handler/**/*.go",
        "**/service/**/*.go"
      ]
    },
    {
      "output": "use-effect-prefer-events.mdc",
      "guideline": "use-effect-prefer-events.md",
      "description": "useEffect：能不用就不用；不得不用须先提示用户且 effect 极薄",
      "alwaysApply": true
    },
    {
      "output": "document-list-page-simple.mdc",
      "guideline": "document-list-page-simple.md",
      "description": "公司仓单据列表页：目录瘦身、复杂度预算、双视图 remount-init；勿整页抄维修单",
      "alwaysApply": false,
      "globs": [
        "src/pages/**/index.tsx",
        "src/pages/**/list*.tsx",
        "src/pages/**/List*.tsx",
        "**/config/listFields.*",
        "**/config/listColumns.*",
        "**/config/detailFields.*",
        "**/config/detailColumns.*",
        "**/utils/statusActions.*"
      ]
    },
    {
      "output": "order-jump.mdc",
      "guideline": "order-jump.md",
      "description": "公司仓点业务单号进详情：优先 jumpToOrderDetail（orderJump）；禁止列内复制 path；跨应用用 wujie jump",
      "alwaysApply": false,
      "globs": [
        "**/orderJump.ts",
        "**/relatedOrder*.tsx",
        "**/RelatedOrder*.tsx",
        "**/relatedOrderColumns.*",
        "**/*Columns*.tsx",
        "src/pages/**/index.tsx"
      ]
    }
  ]
}
